 END SUBROUTINE udm_winter_capture
+
+! Scratch-only observation of the temporary CU contribution to QI immediately
+! after radiation_driver's qi = qi + qi_cu * (cldfra_dp+cldfra_sh).
+! Record schema, in order:
+! tag, rank, domain(1 for this single-domain replay), step, i,j,k,
+! icloud_cu,cu_physics,icloud_bl_present,icloud_bl,F_QI,qi_bl_present,
+! qc_bl_present,cldfra_bl_present, seconds,
+! qi_saved,qi_before_cu,qi_cu,cldfra_dp,cldfra_sh,cu_fraction,
+! qi_cu_increment,qi_after_cu,qc_saved,qc_before_cu,qc_cu,qi_bl,
+! cldfra_bl,aercu_opt. Absent optional values and unsaved hydrometeors use
+! -999 sentinels; this routine never modifies model state.
+SUBROUTINE udm_winter_capture_cu_adjustment(step, seconds, i, j, k, flags, values)
+  IMPLICIT NONE
+  INTEGER, INTENT(IN) :: step,i,j,k,flags(8)
+  REAL, INTENT(IN) :: seconds,values(14)
+  CHARACTER(LEN=1024) :: outdir,filename
+  INTEGER :: stat,unit,rank
+  LOGICAL, SAVE :: configured=.FALSE., enabled=.FALSE.
+  CHARACTER(LEN=1024), SAVE :: cached_dir
+  !$OMP CRITICAL(udm_winter_cu_capture_config)
+  IF (.NOT.configured) THEN
+    CALL GET_ENVIRONMENT_VARIABLE('WRF_UDM_CU_CAPTURE_DIR',cached_dir,STATUS=stat)
+    enabled=(stat==0 .AND. LEN_TRIM(cached_dir)>0)
+    configured=.TRUE.
+  END IF
+  !$OMP END CRITICAL(udm_winter_cu_capture_config)
+  IF (.NOT.enabled) RETURN
+  IF (step<167 .OR. step>171) RETURN
+  IF (seconds<10020. .OR. seconds>10200.) RETURN
+  IF (i/=17 .OR. j/=58 .OR. k<6 .OR. k>8) RETURN
+  CALL wrf_get_myproc(rank)
+  outdir=TRIM(cached_dir)
+  WRITE(filename,'(A,"/cu_qi_adjust_rank",I4.4,".csv")') TRIM(outdir),rank
+  OPEN(NEWUNIT=unit,FILE=TRIM(filename),STATUS='UNKNOWN',POSITION='APPEND', &
+       ACTION='WRITE',IOSTAT=stat)
+  IF (stat/=0) RETURN
+  WRITE(unit,'(A,1X,14(I0,1X),15(ES25.16E3,1X))',IOSTAT=stat) &
+       'CU_QI_ADJUST_V1',rank,1,step,i,j,k,flags,seconds,values
+  CLOSE(unit)
+END SUBROUTINE udm_winter_capture_cu_adjustment
