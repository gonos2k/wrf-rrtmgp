+! Scratch-only, opt-in diagnostic for the Jan-2000 QI investigation.
+! This routine only appends observed values; it never writes model state.
+SUBROUTINE udm_winter_capture(stage, temp_kind, rank, domain, step, seconds, i, j, k, &
+     ims, ime, kms, kme, jms, jme, its, ite, kts, kte, jts, jte, values)
+  IMPLICIT NONE
+  CHARACTER(LEN=*), INTENT(IN) :: stage, temp_kind
+  INTEGER, INTENT(IN) :: rank,domain,step,i,j,k
+  INTEGER, INTENT(IN) :: ims,ime,kms,kme,jms,jme,its,ite,kts,kte,jts,jte
+  REAL, INTENT(IN) :: seconds, values(16)
+  CHARACTER(LEN=1024) :: outdir,filename
+  INTEGER :: stat,unit
+  LOGICAL, SAVE :: configured=.FALSE., enabled=.FALSE.
+  CHARACTER(LEN=1024), SAVE :: cached_dir
+  !$OMP CRITICAL(udm_winter_capture_config)
+  IF (.NOT.configured) THEN
+    CALL GET_ENVIRONMENT_VARIABLE('WRF_UDM_WINTER_CAPTURE_DIR',cached_dir,STATUS=stat)
+    enabled=(stat==0 .AND. LEN_TRIM(cached_dir)>0)
+    configured=.TRUE.
+  END IF
+  !$OMP END CRITICAL(udm_winter_capture_config)
+  IF (.NOT.enabled) RETURN
+  ! Radiation is at elapsed minute 170 (14:50); solve_em increments
+  ! itimestep before invoking first_rk_step_part1, so include nearby step
+  ! labels while the elapsed-time window is the authoritative selector.
+  IF (step<167 .OR. step>172) RETURN
+  IF (seconds<10020. .OR. seconds>10260.) RETURN
+  IF (i/=17 .OR. j/=58 .OR. k<6 .OR. k>8) RETURN
+  WRITE(filename,'(A,"/rank",I4.4,".csv")') TRIM(cached_dir),rank
+  OPEN(NEWUNIT=unit,FILE=TRIM(filename),STATUS='UNKNOWN',POSITION='APPEND', &
+       ACTION='WRITE',IOSTAT=stat)
+  IF (stat/=0) RETURN
+  WRITE(unit,'(A,1X,A,1X,6(I0,1X),17(ES24.16E3,1X),12(I0,1X))') &
+       TRIM(stage),TRIM(temp_kind),rank,domain,step,i,j,k,seconds,values, &
+       ims,ime,jms,jme,kms,kme,its,ite,jts,jte,kts,kte
+  CLOSE(unit)
+END SUBROUTINE udm_winter_capture
