 CONTAINS
+  SUBROUTINE write_lw_transport_trace(path)
+    CHARACTER(LEN=*), INTENT(IN) :: path
+    INTEGER :: unit,stat
+    INTEGER, ALLOCATABLE :: bounds(:,:)
+    REAL(wp), ALLOCATABLE :: wn_bounds(:,:),policy_value(:,:,:),bounds_value(:,:,:)
+    OPEN(NEWUNIT=unit,FILE=path,STATUS='NEW',ACTION='WRITE',IOSTAT=stat)
+    IF(stat/=0) ERROR STOP 'could not create LW transport trace'
+    WRITE(unit,'(A)',IOSTAT=stat) 'RRTMGP_RESULT_V1'
+    IF(stat/=0) ERROR STOP 'failed LW transport result magic write'
+    WRITE(unit,'(A,1X,I0,1X,I0)',IOSTAT=stat) 'LW',nc,nl
+    IF(stat/=0) ERROR STOP 'failed LW transport trace dimensions write'
+    ALLOCATE(policy_value(1,1,1)); policy_value(1,1,1)=REAL(lw_transport_policy,wp)
+    CALL write3(unit,'TRANSPORT_POLICY',policy_value)
+    CALL write3(unit,'SOURCE_LAYER',lw_source%lay_source)
+    CALL write3(unit,'SOURCE_LEVEL',lw_source%lev_source)
+    CALL write3(unit,'SOURCE_SURFACE',RESHAPE(lw_source%sfc_source,[nc,1,SIZE(lw_source%sfc_source,2)]))
+    bounds=gas_lw%get_band_lims_gpoint()
+    ALLOCATE(bounds_value(SIZE(bounds,1),SIZE(bounds,2),1))
+    bounds_value(:,:,1)=REAL(bounds,wp)
+    CALL write3(unit,'BAND_LIMITS_GPOINT',bounds_value)
+    wn_bounds=gas_lw%get_band_lims_wavenumber()
+    CALL write3(unit,'BAND_LIMITS_WAVENUMBER',RESHAPE(wn_bounds,[SIZE(wn_bounds,1),SIZE(wn_bounds,2),1]))
+    IF(lw_transport_policy==2) THEN
+      policy_value(1,1,1)=1.66_wp
+      CALL write3(unit,'LW_DIFFUSIVITY_ANGLE',policy_value)
+    ELSE IF(lw_transport_policy==3) THEN
+      policy_value(1,1,1)=4._wp
+      CALL write3(unit,'GAUSS_ANGLE_COUNT',policy_value)
+    END IF
+    CLOSE(unit,IOSTAT=stat)
+    IF(stat/=0) ERROR STOP 'failed to close LW transport trace'
+  END SUBROUTINE write_lw_transport_trace
