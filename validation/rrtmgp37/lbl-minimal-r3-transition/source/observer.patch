+! UDM37_MIN_BEGIN
+SUBROUTINE UDM37_MIN_XINT (V1A,V2A,DVA,A,AFACT,VFT,DVR3,R3,N1R3,N2R3)
+!
+   USE udm37_min_r3
+   IMPLICIT REAL*8           (V)
+   REAL*8 :: udm37_min_before
+!
+!     THIS SUBROUTINE INTERPOLATES THE A ARRAY STORED
+!     FROM V1A TO V2A IN INCREMENTS OF DVA USING A MULTIPLICATIVE
+!     FACTOR AFACT, INTO THE R3 ARRAY FROM LOCATION N1R3 TO N2R3 IN
+!     INCREMENTS OF DVR3
+!
+   COMMON /LAMCHN/ ONEPL,ONEMI,EXPMIN,ARGMIN
+   DIMENSION A(*),R3(*)
+!
+   RECDVA = 1./DVA
+   ILO = (V1A+DVA-VFT)/DVR3+1.+ONEMI
+   ILO = MAX(ILO,N1R3)
+   IHI = (V2A-DVA-VFT)/DVR3+ONEMI
+   IHI = MIN(IHI,N2R3)
+!
+   CALL min_emit('XINT_CALL',0,0,0,0,0,[V1A,V2A,DVA,AFACT,REAL(ILO,8),REAL(IHI,8)])
+   DO 10 I = ILO, IHI
+      VI = VFT+DVR3* REAL(I-1)
+      J = (VI-V1A)*RECDVA+ONEPL
+      VJ = V1A+DVA* REAL(J-1)
+      P = RECDVA*(VI-VJ)
+      C = (3.-2.*P)*P*P
+      B = 0.5*P*(1.-P)
+      B1 = B*(1.-P)
+      B2 = B*P
+      CONTI = -A(J-1)*B1+A(J)*(1.-C+B2)+A(J+1)*(C+B1)-A(J+2)*B2
+      IF(min_active.AND.min_k>0.AND.I==min_k) udm37_min_before=R3(I)
+      R3(I) = R3(I)+CONTI*AFACT
+      IF(min_active.AND.min_k>0.AND.I==min_k) &
+      CALL min_write('XINT_WRITE',I,J,0,0,udm37_min_before,R3(I),CONTI,AFACT,1D0,VI,0D0,0D0)
+10 END DO
+!
+   RETURN
+!
+end subroutine UDM37_MIN_XINT
+! UDM37_MIN_END
