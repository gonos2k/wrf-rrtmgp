+   SUBROUTINE qnn_boundary_capture_config(enabled,directory)
+      LOGICAL, INTENT(OUT) :: enabled
+      CHARACTER(LEN=*), INTENT(OUT) :: directory
+      CHARACTER(LEN=32) :: gate
+      INTEGER :: n, status
+      enabled=.false.
+      directory=''
+      CALL GET_ENVIRONMENT_VARIABLE('WRF_UDM_QNN_BOUNDARY_CAPTURE',gate,LENGTH=n,STATUS=status)
+      IF(status==1.OR.(status==0.AND.n==0)) RETURN
+      IF(status/=0.OR.n/=1) CALL wrf_error_fatal('QNN_BOUNDARY_CAPTURE: gate must be empty or exactly 1')
