+                  IF(ieee_is_finite(native_rho).AND.native_rho>0.) valid=1
+               ENDIF
+            ENDIF
+         ENDIF
+      ENDIF
+      WRITE(unit,'(5(I0,1X),13(ES26.17E3,1X))',IOSTAT=ios) &
+         k,branch,source_i,source_j,valid, &
+         REAL(velocity,8),REAL(ccn,8),REAL(before,8),REAL(after,8), &
+         REAL(nc_before,8),REAL(nc_after,8),REAL(nr_before,8),REAL(nr_after,8), &
+         REAL(al,8),REAL(alb,8),REAL(native_sum,8),REAL(native_rho,8),REAL(source_nn,8)
+      IF(ios/=0) CALL wrf_error_fatal('QNN_BOUNDARY_CAPTURE: row write failed')
+   END SUBROUTINE qnn_boundary_write_row
