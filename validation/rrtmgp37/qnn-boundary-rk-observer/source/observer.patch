+      REAL :: native_sum,native_rho
+      REAL(KIND=8) :: wide_sum
+      INTEGER :: valid,ios
+      ! Invalid arithmetic is recorded explicitly; no physical field is changed.
+      valid=0
+      native_sum=0.
+      native_rho=0.
+      IF(ieee_is_finite(al).AND.ieee_is_finite(alb)) THEN
+         wide_sum=REAL(al,KIND=8)+REAL(alb,KIND=8)
+         IF(wide_sum>0.D0.AND.wide_sum<=REAL(HUGE(1.),KIND=8)) THEN
+            native_sum=al+alb
