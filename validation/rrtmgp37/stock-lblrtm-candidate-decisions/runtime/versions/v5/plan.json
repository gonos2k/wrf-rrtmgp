  "durability_and_cleanup": {
    "actual_rc": "Actual child return code is atomically written and fsynced with the parent directory immediately after wait/timeout reap, before stdout/stderr hashes, object/executable hashes, output inventory, or comparison.",
    "exception": "If launch fails or runner errors after launch, terminate/reap any live process and atomically preserve failure/RC receipt; never infer success from a marker.",
    "inputs": "All 38 staged inputs are byte-hash/size checked before launch and checked again after the process is terminal/reaped. Symlink target identity is also checked. A failed post-pin blocks output inventory/comparison.",
    "lock": "O_EXCL one-use build/solver lock, retained for every outcome; no retry or overwrite",
    "outputs": "On solver nonzero/timeout, preserve logs and skip output parsing/comparison. On RC0, inventory and compare only after durable execution.json.",
    "successful_status_contract": "Accept solver only when receipt status TERMINAL, child_status CHILDRC0, actual_child_returncode 0, timed_out false, exception null, and reaped true; any timeout/exception/reap uncertainty/input mismatch blocks output comparison.",
    "timeout": "Start a new process group; at 600/7200 seconds send SIGTERM, wait 10 seconds, then SIGKILL and reap; record timeout and actual return code.",
    "timeout_reap_gate": "A timed-out child is never accepted even if its eventual actual RC is zero. TERM/KILL+wait is bounded; if reaping cannot be proven, receipt status is REAP_PENDING, RC may be null, and no output inventory/comparison follows."
  },
