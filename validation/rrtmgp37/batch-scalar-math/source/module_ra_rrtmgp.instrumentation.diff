+  SUBROUTINE wp_probe2(label,a)
+    CHARACTER(LEN=*),INTENT(IN)::label
+    REAL(wp),INTENT(IN)::a(:,:)
+    CHARACTER(LEN=1024)::path
+    INTEGER::u,ios,i,j
+    INTEGER(int64)::bits
+    CALL GET_ENVIRONMENT_VARIABLE('RRTMGP_WP_CAPTURE_FILE',path,STATUS=ios)
+    IF(ios/=0.OR.LEN_TRIM(path)==0) RETURN
+    OPEN(NEWUNIT=u,FILE=TRIM(path),STATUS='UNKNOWN',POSITION='APPEND',ACTION='WRITE',IOSTAT=ios)
+    IF(ios/=0) RETURN
+    WRITE(u,'(A,1X,I0,1X,I0)') TRIM(label),SIZE(a,1),SIZE(a,2)
+    DO j=1,SIZE(a,2); DO i=1,SIZE(a,1)
+      bits=TRANSFER(REAL(a(i,j),real64),bits)
+      WRITE(u,'(Z16.16)') bits
+    END DO; END DO
+    CLOSE(u)
+  END SUBROUTINE
+  SUBROUTINE wp_probe3(label,a)
+    CHARACTER(LEN=*),INTENT(IN)::label
