+    IF(ios/=0) RETURN
+    WRITE(u,'(A,1X,I0,1X,I0,1X,I0)') TRIM(label),SIZE(a,1),SIZE(a,2),SIZE(a,3)
+    DO k=1,SIZE(a,3); DO j=1,SIZE(a,2); DO i=1,SIZE(a,1)
+      bits=TRANSFER(REAL(a(i,j,k),real64),bits)
+      WRITE(u,'(Z16.16)') bits
+    END DO; END DO; END DO
+    CLOSE(u)
+  END SUBROUTINE
