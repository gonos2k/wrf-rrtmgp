+    if(ios/=0.or.n/=1.or.value(1:1)/='1') error stop 'UDM_NUMBER_STAGE: gate must be empty or1'
+    if(.not.present(time_minutes)) error stop 'UDM_NUMBER_STAGE: enabled observer requires XTIME'
+    context%time_minutes=time_minutes
+    if(.not.udm_num_is_finite(time_minutes).or..not.udm_num_is_finite(driver_dt).or. &
+       .not.udm_num_is_finite(ccn_source)) error stop 'UDM_NUMBER_STAGE: nonfinite clock/seed'
+    if(driver_dt<=0..or.time_minutes<0.) error stop 'UDM_NUMBER_STAGE: invalid clock'
+    if(storage_size(1.)/=32.or.domain/=1) error stop 'UDM_NUMBER_STAGE: selected REAL32 domain1 only'
+    call get_environment_variable('WRF_UDM_NUMBER_STAGE_DIR',value,length=n,status=ios)
+    if(ios/=0.or.n<1.or.n>len(context%directory)) error stop 'UDM_NUMBER_STAGE: invalid directory'
+    context%directory=value
+    context%enabled=.true.
+  end subroutine udm_number_configure
+
+  logical function udm_number_selected(context,its,ite,j)
+    type(udm_number_observer_context), optional, intent(in) :: context
+    integer,intent(in) :: its,ite,j
+    udm_number_selected=.false.
+    if(.not.present(context)) return
+    if(.not.context%enabled) return
+    udm_number_selected=context%selected_i>=its.and.context%selected_i<=ite.and.j==context%selected_j
+  end function udm_number_selected
+
+  subroutine udm_number_write(context,step,stage,substep,tile,i,j,kts,kte,t,pressure,qv,qc,qr,nn,nc,nr,rho, &
+                               dend,re_cloud,nc_act,pc_act,dt_substep)
+    type(udm_number_observer_context),intent(in) :: context
+    integer,intent(in) :: step,stage,substep,i,j,kts,kte
+    integer,optional,intent(in) :: tile
+    real,intent(in) :: t(:),pressure(:),qv(:),qc(:),qr(:),nn(:),nc(:),nr(:),rho(:)
+    real,optional,intent(in) :: dend(:),re_cloud(:),nc_act(:),pc_act(:),dt_substep
+    integer :: unit,ios,n,k,available,initializer
+    real :: values(14)
+    character(len=1200) :: filename
+    if(.not.context%enabled) return
+    if(.not.present(tile)) error stop 'UDM_NUMBER_STAGE: missing tile'
+    n=kte-kts+1
+    if(n/=44.or.kts/=1.or.tile<1.or.step<1.or.i/=23.or.j/=2) &
+      error stop 'UDM_NUMBER_STAGE: invalid selected identity/shape'
+    if(size(t)/=n.or.size(pressure)/=n.or.size(qv)/=n.or.size(qc)/=n.or.size(qr)/=n.or. &
+       size(nn)/=n.or.size(nc)/=n.or.size(nr)/=n.or.size(rho)/=n) error stop 'UDM_NUMBER_STAGE: vector shape'
+    available=0
+    if(present(dend)) then
+      if(size(dend)/=n) error stop 'UDM_NUMBER_STAGE: DEND shape'
+      available=ibset(available,0)
+    endif
+    if(present(re_cloud)) then
+      if(size(re_cloud)/=n) error stop 'UDM_NUMBER_STAGE: radius shape'
+      available=ibset(available,1)
+    endif
+    if(present(nc_act)) then
+      if(size(nc_act)/=n) error stop 'UDM_NUMBER_STAGE: ncact shape'
+      available=ibset(available,2)
+    endif
+    if(present(pc_act)) then
+      if(size(pc_act)/=n) error stop 'UDM_NUMBER_STAGE: pcact shape'
+      available=ibset(available,3)
+    endif
+    if(present(dt_substep)) available=ibset(available,4)
+    initializer=0
+    if(context%initializer_active) initializer=1
+    write(filename,'(a,"/number_d",i0,"_tile",i0,"_i",i0,"_j",i0,"_step",i0,"_stage",i0,"_sub",i0,".raw")') &
+      trim(context%directory),context%domain,tile,i,j,step,stage,substep
+    open(newunit=unit,file=trim(filename),status='new',action='write',iostat=ios)
+    if(ios/=0) error stop 'UDM_NUMBER_STAGE: OPEN new packet failed'
+    write(unit,'(a)',iostat=ios) 'UDM37NUM1'
+    if(ios/=0) error stop 'UDM_NUMBER_STAGE: magic write failed'
+    write(unit,'(12(i0,1x))',iostat=ios) context%domain,step,stage,substep,tile,i,j,kts,kte, &
+      storage_size(1.),available,initializer
+    if(ios/=0) error stop 'UDM_NUMBER_STAGE: header write failed'
+    write(unit,'(3(es26.17e3,1x))',iostat=ios) real(context%time_minutes,udm_num_real64), &
+      real(context%driver_dt,udm_num_real64),real(context%ccn_source,udm_num_real64)
+    if(ios/=0) error stop 'UDM_NUMBER_STAGE: clock write failed'
+    do k=1,n
+      values=0.
+      values(1:9)=[t(k),pressure(k),qv(k),qc(k),qr(k),nn(k),nc(k),nr(k),rho(k)]
+      if(present(dend)) values(10)=dend(k)
+      if(present(re_cloud)) values(11)=re_cloud(k)
+      if(present(nc_act)) values(12)=nc_act(k)
+      if(present(pc_act)) values(13)=pc_act(k)
+      if(present(dt_substep)) values(14)=dt_substep
+      if(.not.all(udm_num_is_finite(values))) error stop 'UDM_NUMBER_STAGE: nonfinite selected row'
+      write(unit,'(i0,1x,14(es26.17e3,1x))',iostat=ios) kts+k-1,real(values,udm_num_real64)
+      if(ios/=0) error stop 'UDM_NUMBER_STAGE: row write failed'
+    enddo
+    flush(unit,iostat=ios)
+    if(ios/=0) error stop 'UDM_NUMBER_STAGE: FLUSH failed'
+    close(unit,iostat=ios)
+    if(ios/=0) error stop 'UDM_NUMBER_STAGE: CLOSE failed'
+  end subroutine udm_number_write
+! END UDM_NUMBER_STAGE_OBSERVER
 end module module_mp_udm
